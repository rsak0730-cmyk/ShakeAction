<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1120"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Moto Actions Pro"
            android:textColor="#F8FAFC"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:text="100% Motorola-grade motion engine &amp; custom actions"
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <!-- Service Control & Permissions Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="#1E293B"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvServiceStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Status: Stopped"
                android:textColor="#38BDF8"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnStartService"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="#10B981"
                    android:text="Start Engine"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnStopService"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="#EF4444"
                    android:text="Stop Engine"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btnGrantPermissions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="#334155"
                android:text="Setup DND, Overlay &amp; Battery Permissions"
                android:textColor="#E2E8F0"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 1. FAST CHOP-CHOP -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="#1E293B"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Fast Chop-Chop (Double Lateral Chop)"
                android:textColor="#FBBF24"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Two crisp sideways chops (Default: Flashlight)"
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/spinnerChopAction"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="#334155"
                android:paddingHorizontal="8dp" />

            <Button
                android:id="@+id/btnPickChopApp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:backgroundTint="#475569"
                android:text="Select App for Chop-Chop"
                android:textColor="#FFFFFF"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvChopSensitivity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Chop Sensitivity: Medium (Moto Default)"
                android:textColor="#CBD5E1"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/seekChopSensitivity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="55" />
        </LinearLayout>

        <!-- 2. QUICK TWIST-TWIST -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="#1E293B"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. Quick Twist-Twist (Double Wrist Rotation)"
                android:textColor="#38BDF8"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Twist wrist twice quickly (Default: Open Camera)"
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/spinnerTwistAction"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="#334155"
                android:paddingHorizontal="8dp" />

            <Button
                android:id="@+id/btnPickTwistApp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:backgroundTint="#475569"
                android:text="Select App for Twist-Twist"
                android:textColor="#FFFFFF"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvTwistSensitivity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Twist Sensitivity: Medium (Moto Default)"
                android:textColor="#CBD5E1"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/seekTwistSensitivity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="55" />
        </LinearLayout>

        <!-- 3. PICK UP GESTURE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="#1E293B"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. Pick Up Gesture (Lift Phone)"
                android:textColor="#A78BFA"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Lift phone from flat surface to upright (Default: Silent/Vibrate)"
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/spinnerPickupAction"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="#334155"
                android:paddingHorizontal="8dp" />

            <Button
                android:id="@+id/btnPickPickupApp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:backgroundTint="#475569"
                android:text="Select App for Pick Up"
                android:textColor="#FFFFFF"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 4. FLIP FOR DO NOT DISTURB -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="#1E293B"
            android:orientation="vertical"
            android:padding="14dp">

            <Switch
                android:id="@+id/switchFlipDnd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="4. Flip for Do Not Disturb"
                android:textColor="#F472B6"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Place phone face-down to activate DND; pick up to restore normal mode"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
